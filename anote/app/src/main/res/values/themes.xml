<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Anote" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg_bottom</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>

    <!-- Dialogos: mesma paleta do app. Claro na tela de notas, escuro no painel de emergencia. -->
    <style name="Anote.Dialog.Light" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorHint">@color/hint</item>
    </style>

    <style name="Anote.Dialog.Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorOnSurfaceVariant">@color/dark_muted</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorHint">@color/dark_muted</item>
    </style>
</resources>
